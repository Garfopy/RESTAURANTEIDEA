Options -Indexes
RewriteEngine On
RewriteBase /carnihub/

# Block sensitive directories
RewriteRule ^(config|app)/.*$ - [F,L]

# Serve static files/directories directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Route everything else to index.php via query string
RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
